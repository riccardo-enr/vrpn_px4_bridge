<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vrpn_px4_bridge</name>
  <version>0.1.0</version>
  <description>
    ROS 2 C++ node that relays vrpn_mocap (Vicon/OptiTrack) pose to PX4 as
    VehicleOdometry, converting the mocap ENU world frame to PX4 NED.
  </description>
  <maintainer email="riccardo.enrico97@proton.me">Riccardo Enrico</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>px4_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
